diff --git a/build/config/haiku/compat/sys/endian.h b/build/config/haiku/compat/sys/endian.h
new file mode 100644
index 0000000..27709e8
--- /dev/null
+++ b/build/config/haiku/compat/sys/endian.h
@@ -0,0 +1,8 @@
+// Haiku compat <sys/endian.h> (FreeBSD style).
+#pragma once
+#include <endian.h>
+#ifndef bswap16
+#define bswap16(x) __builtin_bswap16(x)
+#define bswap32(x) __builtin_bswap32(x)
+#define bswap64(x) __builtin_bswap64(x)
+#endif
diff --git a/build/config/haiku/compat/sys/syscall.h b/build/config/haiku/compat/sys/syscall.h
