diff --git a/build/config/haiku/compat/linux/haiku_ioc.h b/build/config/haiku/compat/linux/haiku_ioc.h
new file mode 100644
index 0000000..5b9d440
--- /dev/null
+++ b/build/config/haiku/compat/linux/haiku_ioc.h
@@ -0,0 +1,21 @@
+// Linux-style _IO/_IOR/_IOW/_IOWR encoding for code that only builds ioctl
+// numbers (they're never issued on Haiku).
+#ifndef HAIKU_COMPAT_IOC_H
+#define HAIKU_COMPAT_IOC_H
+#ifndef _IOC
+#define _IOC(dir, type, nr, size) \
+  ((unsigned long)(((dir) << 30) | ((size) << 16) | ((type) << 8) | (nr)))
+#endif
+#ifndef _IO
