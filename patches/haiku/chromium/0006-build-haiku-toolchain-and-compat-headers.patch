+#pragma once
diff --git a/build/config/haiku/compat/sys/sysmacros.h b/build/config/haiku/compat/sys/sysmacros.h
new file mode 100644
index 0000000..becb8d5
--- /dev/null
+++ b/build/config/haiku/compat/sys/sysmacros.h
@@ -0,0 +1,9 @@
+// Haiku dev_t has no major/minor split; these only make DRM-related code
+// compile (it is never used on Haiku).
+#pragma once
+#include <sys/types.h>
+#ifndef major
