+# Chromium-HaikuOS: Tint's source files are generated by a Go program
+# (src/cmd/gen) that needs Go 1.26 or newer, which Haiku does not have.
+# The generated files are produced once on another machine from the Dawn
+# revision this Chromium release pins and shipped as prebuilt/tint-gen.tar.gz
+# in the Chromium-HaikuOS repository; scripts/build.sh unpacks them into the
+# build directory. This replacement only checks that they are there.
 import os
-import subprocess
 import sys
 
-SCRIPT_DIR = os.path.dirname(__file__)
-CMD_DIR = os.path.join(SCRIPT_DIR, 'src', 'cmd')
-DAWN_ROOT = os.path.realpath(os.path.join(SCRIPT_DIR, '..'))
-
-sys.path.insert(0, DAWN_ROOT)
-
-from tools.python import cipd_deps
-
-
-def main() -> int:
-    go_binary = "go"
-    if sys.platform == 'win32':
-        go_binary += '.exe'
-
-    tool_dir = os.path.relpath(os.path.join(CMD_DIR, 'gen', 'sources'),
-                               DAWN_ROOT)
-    # Go expects package paths relative to module root to start with './' or
-    # '../'. On Windows, absolute paths starting with a drive letter (e.g.,
-    # 'C:\') are mistaken by Go for package import paths. Therefore, represent
-    # the package path as a relative path starting with './' and using forward
-    # slashes.
-    tool_dir = './' + tool_dir.replace(os.path.sep, '/')
-
-    cmd = [
-        go_binary,
-        'run',
-        tool_dir,
-        os.path.join(os.getcwd(), sys.argv[1]),
-    ]
-
-    # Force Go modules to be ON so package imports within the dawn module
-    # resolve correctly, overriding any potential system-wide or user-wide
-    # environment settings like GO111MODULE=off.
-    # See https://crbug.com/519743871
-    os.environ['GO111MODULE'] = 'on'
-    # Disable CGO since it causes problems when cross-compiling (see https://crbug.com/516926043).
-    os.environ['CGO_ENABLED'] = '0'
-
-    proc = subprocess.run(cmd, check=False, cwd=DAWN_ROOT)
-    return proc.returncode
-
-
-if __name__ == '__main__':
-    sys.exit(main())
+out = os.path.join(os.getcwd(), sys.argv[1])
+tint = os.path.join(out, "src", "tint")
+if os.path.exists(os.path.join(tint, "lang", "core", "enums.cc")):
+    # Touch the files so ninja sees the action's outputs as up to date.
+    for root, _, files in os.walk(tint):
+        for name in files:
+            os.utime(os.path.join(root, name))
+    sys.exit(0)
+sys.stderr.write(
+    "Pregenerated Tint sources are missing from %s.\n"
+    "scripts/build.sh unpacks prebuilt/tint-gen.tar.gz there; see\n"
+    "docs/TINT.md in Chromium-HaikuOS to regenerate them.\n" % tint)
+sys.exit(1)
