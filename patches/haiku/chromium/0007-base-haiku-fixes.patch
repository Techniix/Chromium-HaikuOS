From: Chromium-HaikuOS contributors
Subject: [PATCH] base: Haiku fixes, memfd shared memory and backtrace() traces

- files/file_posix.cc: Haiku has futimens() and the POSIX.1-2008
  st_atim/st_mtim/st_ctim fields, not the BSD st_*timespec names.
- linux_util.cc: include <sstream> and base/logging.h, which the BSD
  build gets transitively.
- memory/protected_memory_posix.cc: the read-only check probes with
  getrlimit(RLIMIT_NPROC); Haiku has no RLIMIT_NPROC, any resource works
  for the EFAULT probe.
- posix/can_lower_nice_to.cc: Haiku has no NZERO; use the usual 20.
- process/launch_posix.cc: no /dev/fd or /proc fd directory; the
  directory read fails and every descriptor is closed, which is correct.
- process/process_metrics_posix.cc: default descriptor limit 1024.
- process/set_process_title.cc: no setproctitle(); the team name comes
  from argv[0].
- profiler/module_cache_posix.cc: Haiku's <elf.h> calls PF_X PF_EXECUTE.

Renga (Techniix/haiku ce/main):

- memory/platform_shared_memory_region_posix.cc, .h: use the Linux
  memfd-backed region code (memfd_create() with MFD_ALLOW_SEALING and
  MFD_NOEXEC_SEAL, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL), calling
  Renga's libgnu memfd_create() function instead of syscall(), and
  CreateUnsafeAnonymous() for in-process unsafe regions (also enabled in
  mojo/core/ipcz_driver/base_shared_memory_service.cc, so renderer and
  GPU processes create them without a broker round trip). Writable regions
  also need a second, read-only open file description, which Linux gets
  by reopening /proc/self/fd/N; Renga has no /proc (RENGA-REQUESTS.md
  R-1), so for them the open() fails and Create() falls back to a file in
  the temporary directory, as before.
- debug/stack_trace_posix.cc: HAVE_BACKTRACE on Haiku. Stack traces use
  backtrace() and backtrace_symbols() (demangled) outside the signal
  handler. In the signal handler, where glibc's backtrace_symbols_fd() is
  not safe, Renga's does not allocate, so a crash prints
  "image(symbol+0xoffset) [address]" frames to stderr instead of bare
  addresses. Frames in non-exported functions print as image(+0xoffset);
  tools/symbolize-trace.py resolves them with llvm-symbolizer. (The
  /proc/self/maps based symbolizer is left out in patch 0002.)
---
diff --git a/base/debug/stack_trace_posix.cc b/base/debug/stack_trace_posix.cc
index 52d4ec2..b535333 100644
--- a/base/debug/stack_trace_posix.cc
+++ b/base/debug/stack_trace_posix.cc
@@ -46,9 +46,10 @@
 
 // Surprisingly, uClibc defines __GLIBC__ in some build configs, but
 // execinfo.h and backtrace(3) are really only present in glibc and in macOS
-// libc.
-#if BUILDFLAG(IS_APPLE) || \
-    (defined(__GLIBC__) && !defined(__UCLIBC__) && !defined(__AIX) && !(BUILDFLAG(IS_BSD) || BUILDFLAG(IS_HAIKU)))
+// libc. Renga (the Haiku fork) has them in libgnu, with frames found from the
+// unwind tables and a backtrace_symbols_fd() that does not allocate.
+#if BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_HAIKU) || \
+    (defined(__GLIBC__) && !defined(__UCLIBC__) && !defined(__AIX) && !BUILDFLAG(IS_BSD))
 #define HAVE_BACKTRACE
 #include <execinfo.h>
 #endif
@@ -165,6 +166,13 @@ class BacktraceOutputHandler {
  public:
   virtual void HandleOutput(const char* output) = 0;
 
+#if BUILDFLAG(IS_HAIKU)
+  // The descriptor this handler writes to, or -1 if it does not write to a
+  // descriptor. Lets ProcessBacktrace() name frames inside the signal
+  // handler with Renga's non-allocating backtrace_symbols_fd().
+  virtual int OutputFileDescriptor() const { return -1; }
+#endif
+
  protected:
   virtual ~BacktraceOutputHandler() = default;
 };
@@ -309,6 +317,23 @@ void ProcessBacktrace(span<const void* const> traces,
 #endif  // defined(HAVE_DLADDR)
   }
 
+#if BUILDFLAG(IS_HAIKU)
+  // In the signal handler glibc's backtrace_symbols_fd() is not safe (it may
+  // allocate while loading libgcc), so Linux prints bare addresses there.
+  // Renga's does not allocate, so print "image(symbol+0xoffset) [address]"
+  // frames instead; frames in static functions come out as
+  // "image(+0xoffset)" for tools/symbolize-trace.py (they are not demangled
+  // here, which would need malloc).
+  if (!printed && in_signal_handler != 0 &&
+      handler->OutputFileDescriptor() >= 0 &&
+      IsValueInRangeForNumericType<int>(traces.size())) {
+    backtrace_symbols_fd(const_cast<void* const*>(traces.data()),
+                         static_cast<int>(traces.size()),
+                         handler->OutputFileDescriptor());
+    printed = true;
+  }
+#endif  // BUILDFLAG(IS_HAIKU)
+
   if (!printed) {
     for (const void* const trace : traces) {
       handler->HandleOutput(" [");
@@ -621,6 +646,10 @@ class PrintBacktraceOutputHandler : public BacktraceOutputHandler {
     // stack dumping signal handler). NO malloc or stdio is allowed here.
     PrintToStderr(output);
   }
+
+#if BUILDFLAG(IS_HAIKU)
+  int OutputFileDescriptor() const override { return STDERR_FILENO; }
+#endif
 };
 
 class StreamBacktraceOutputHandler : public BacktraceOutputHandler {
