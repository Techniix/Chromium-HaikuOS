     size_t size) {
@@ -276,7 +288,7 @@ PlatformSharedMemoryRegion PlatformSharedMemoryRegion::CreateUnsafeAnonymous(
   return PlatformSharedMemoryRegion(std::move(anonymous_region), Mode::kUnsafe,
                                     size, UnguessableToken::Create());
 }
-#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_HAIKU)
 
 // static
