-#if (BUILDFLAG(IS_BSD) || BUILDFLAG(IS_HAIKU))
+#if BUILDFLAG(IS_BSD)  // Haiku: no audio-backend flag
     {"audio-backend",
      flag_descriptions::kAudioBackendName,
      flag_descriptions::kAudioBackendDescription, kOsLinux,
