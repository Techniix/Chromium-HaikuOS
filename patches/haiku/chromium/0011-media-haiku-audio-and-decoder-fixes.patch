-#if BUILDFLAG(IS_LINUX) || (BUILDFLAG(IS_BSD) || BUILDFLAG(IS_HAIKU))
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_BSD)
   return std::make_unique<VideoCaptureDeviceFactoryLinux>(ui_task_runner);
 #elif BUILDFLAG(IS_CHROMEOS)
   if (base::SysInfo::IsRunningOnChromeOS())
@@ -85,6 +85,12 @@ CreatePlatformSpecificVideoCaptureDeviceFactory(
   return std::make_unique<VideoCaptureDeviceFactoryFuchsia>();
 #elif BUILDFLAG(IS_IOS)
   return CreateFakeVideoCaptureDeviceFactory();
+#elif BUILDFLAG(IS_HAIKU)
+  // Chromium-HaikuOS: no camera backend yet; report no devices instead
+  // of returning null (which crashed the video capture service).
+  auto result = std::make_unique<FakeVideoCaptureDeviceFactory>();
+  result->SetToCustomDevicesConfig({});
+  return result;
 #else
   NOTIMPLEMENTED();
   return nullptr;
diff --git a/media/capture/video/video_capture_buffer_tracker_factory_impl.cc b/media/capture/video/video_capture_buffer_tracker_factory_impl.cc
index c3aca4d..fa7072d 100644
--- a/media/capture/video/video_capture_buffer_tracker_factory_impl.cc
