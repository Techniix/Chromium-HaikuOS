From: Chromium-HaikuOS contributors
Subject: [PATCH] ui: Haiku native window frame by default, input key codes

Renga branch. Chromium's windows go to Renga's Wayland compositor
through its socket ($XDG_RUNTIME_DIR/wayland-0), with Renga's
socket-transport libwayland (package renga_wayland; see patch 0001).
That compositor offers what Chromium 156 expects, so the stock-Haiku
compatibility code is gone from this patch:

- The KDE server-decoration path (protocol target, manager binding in
  WaylandConnection, the XdgToplevel fallback and its OzonePlatformWayland
  checks) is removed. Renga offers zxdg_decoration_manager_v1 in
  server-side mode, which Chromium uses unchanged for the native frame.
- The wl_fixes, WL_KEYBOARD_KEY_STATE_REPEATED and
  wl_pointer.axis_relative_direction guards are removed: Renga's core
  protocol headers come from Wayland 1.24's XML, and its compositor
  offers wl_fixes, wl_seat 10, wl_pointer 9 and wl_keyboard 10.

What remains:

- ozone_platform_wayland.cc: default "Use system title bar and borders"
  to on (custom_frame_pref_default = false), so new profiles get Renga's
  window frame.
- wayland_connection.cc: no DRM/GBM render-node probing on Haiku
  (linux-dmabuf comes with Renga's GPU stage).
- events/keycodes/dom/keycode_converter.*: use the evdev key code tables
  on Haiku as on FreeBSD (Wayland sends evdev codes).
- gfx/linux/dmabuf_uapi.h: Linux _IOC encodings for the dma-buf ioctl
  numbers (only built, never issued: no dma-buf yet).

Chromium 156 ignores xdg_toplevel.configure_bounds
(XdgToplevel::OnConfigureBounds is NOTIMPLEMENTED), so the first window
of a new profile is still sized by scripts/run-chromium.sh.
---
diff --git a/ui/events/keycodes/dom/keycode_converter.cc b/ui/events/keycodes/dom/keycode_converter.cc
index 9272fc7..737dc25 100644
--- a/ui/events/keycodes/dom/keycode_converter.cc
+++ b/ui/events/keycodes/dom/keycode_converter.cc
@@ -15,7 +15,7 @@
 #include "ui/events/keycodes/dom/dom_code.h"
 #include "ui/events/keycodes/dom/dom_key.h"
 
-#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD) || BUILDFLAG(IS_HAIKU)
 #include <linux/input.h>
 #endif
 
@@ -67,7 +67,7 @@ struct DomKeyMapEntry {
 #undef DOM_KEY_UNI
 #undef DOM_KEY_MAP_DECLARATION_END
 
-#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD) || BUILDFLAG(IS_HAIKU)
 
 // The offset between XKB Keycode and evdev code.
 constexpr int kXkbKeycodeOffset = 8;
@@ -188,7 +188,7 @@ int KeycodeConverter::DomCodeToNativeKeycode(DomCode code) {
   return UsbKeycodeToNativeKeycode(static_cast<uint32_t>(code));
 }
 
-#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD) || BUILDFLAG(IS_HAIKU)
 // static
 DomCode KeycodeConverter::XkbKeycodeToDomCode(uint32_t xkb_keycode) {
   // Currently XKB keycode is the native keycode.
diff --git a/ui/events/keycodes/dom/keycode_converter.h b/ui/events/keycodes/dom/keycode_converter.h
index dcb2362..f4c0c6c 100644
--- a/ui/events/keycodes/dom/keycode_converter.h
+++ b/ui/events/keycodes/dom/keycode_converter.h
@@ -65,7 +65,7 @@ class KeycodeConverter {
   // Convert a DomCode into a native keycode.
   static int DomCodeToNativeKeycode(DomCode code);
 
-#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD) || BUILDFLAG(IS_HAIKU)
   // Convert a XKB keycode into a DomCode.
   static DomCode XkbKeycodeToDomCode(uint32_t xkb_keycode);
 
diff --git a/ui/gfx/linux/dmabuf_uapi.h b/ui/gfx/linux/dmabuf_uapi.h
index d8f8e47..0259d0e 100644
--- a/ui/gfx/linux/dmabuf_uapi.h
+++ b/ui/gfx/linux/dmabuf_uapi.h
@@ -7,6 +7,21 @@
 
 #include <sys/types.h>
 
+#if defined(__HAIKU__)  // HAIKU_DMABUF_IOC_V2
+// Linux _IOC encoding, only used to build ioctl numbers (never issued).
+#undef _IOC
+#undef _IO
+#undef _IOR
+#undef _IOW
+#undef _IOWR
+#define _IOC(dir, type, nr, size) \
+  ((unsigned long)(((dir) << 30) | ((size) << 16) | ((type) << 8) | (nr)))
+#define _IO(type, nr) _IOC(0U, (type), (nr), 0)
+#define _IOW(type, nr, t) _IOC(1U, (type), (nr), sizeof(t))
+#define _IOR(type, nr, t) _IOC(2U, (type), (nr), sizeof(t))
+#define _IOWR(type, nr, t) _IOC(3U, (type), (nr), sizeof(t))
+#endif
+
 typedef int32_t  __s32;
 typedef uint32_t __u32;
 typedef uint64_t __u64;
