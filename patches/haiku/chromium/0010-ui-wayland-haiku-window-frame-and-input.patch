         zxdg_toplevel_decoration_.get(), &kToplevelDecorationListener, this);
+  } else if (connection()->kde_server_decoration_manager()) {
+    // Chromium-HaikuOS: fall back to the KDE protocol (Haiku wayland_server).
+    kde_decoration_ = org_kde_kwin_server_decoration_manager_create(
+        connection()->kde_server_decoration_manager(),
+        window()->root_surface()->surface());
+    static constexpr org_kde_kwin_server_decoration_listener
+        kKdeDecorationListener = {
+            .mode = &OnKdeDecorationMode,
+        };
+    org_kde_kwin_server_decoration_add_listener(
+        kde_decoration_, &kKdeDecorationListener, this);
   }
 }
 
