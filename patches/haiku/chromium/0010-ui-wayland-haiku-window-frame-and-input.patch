+// static
+void XdgToplevel::OnKdeDecorationMode(
+    void* data,
+    ::org_kde_kwin_server_decoration* decoration,
+    uint32_t mode) {
+  auto* self = static_cast<XdgToplevel*>(data);
+  DCHECK(self);
+  switch (mode) {
+    case ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER:
+      self->decoration_mode_ = DecorationMode::kServerSide;
+      break;
+    case ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT:
+      self->decoration_mode_ = DecorationMode::kClientSide;
+      break;
+    default:
+      self->decoration_mode_ = DecorationMode::kNone;
+      break;
+  }
+}
+
 void XdgToplevel::SetTopLevelDecorationMode(DecorationMode requested_mode) {
+  if (kde_decoration_) {  // Chromium-HaikuOS
+    if (requested_mode != decoration_mode_) {
+      org_kde_kwin_server_decoration_request_mode(
+          kde_decoration_,
+          requested_mode == DecorationMode::kServerSide
+              ? ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER
+              : ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT);
+    }
+    return;
+  }
   if (!zxdg_toplevel_decoration_ || requested_mode == decoration_mode_) {
     return;
   }
@@ -320,6 +357,17 @@ void XdgToplevel::InitializeXdgDecoration() {
         };
