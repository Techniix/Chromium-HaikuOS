diff --git a/base/process/process_handle_haiku.cc b/base/process/process_handle_haiku.cc
new file mode 100644
index 0000000000..6184a44213
--- /dev/null
+++ b/base/process/process_handle_haiku.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_handle.h"
+
+#include <OS.h>
+#include <image.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "base/files/file_path.h"
+
+// Private libroot syscall wrapper (headers/private/system/syscalls.h). The
+// public API has no way to query another team's parent; this is the same call
+// the old Haiku QtWebEngine port used.
+extern "C" pid_t _kern_process_info(pid_t process, int32 which);
+
+namespace base {
+
+namespace {
+// From headers/private/kernel/thread_defs.h.
+constexpr int32 kParentId = 3;
+}  // namespace
+
+ProcessId GetParentProcessId(ProcessHandle process) {
+  if (process == GetCurrentProcessHandle()) {
+    return getppid();
+  }
+  pid_t parent = _kern_process_info(process, kParentId);
+  return parent < 0 ? -1 : parent;
+}
+
+FilePath GetProcessExecutablePath(ProcessHandle process) {
+  // A team's first B_APP_IMAGE is its executable; image_info::name holds the
+  // absolute path it was loaded from.
+  image_info info;
+  int32 cookie = 0;
+  while (get_next_image_info(process, &cookie, &info) == B_OK) {
+    if (info.type == B_APP_IMAGE) {
+      return FilePath(info.name);
+    }
+  }
+  return FilePath();
+}
+
+}  // namespace base
