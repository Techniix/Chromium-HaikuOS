diff --git a/base/process/process_iterator_haiku.cc b/base/process/process_iterator_haiku.cc
new file mode 100644
index 0000000000..038ac7fbda
--- /dev/null
+++ b/base/process/process_iterator_haiku.cc
@@ -0,0 +1,63 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_iterator.h"
+
+#include <OS.h>
+#include <image.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/process/process_handle.h"
+#include "base/strings/string_split.h"
+
+namespace base {
+
+ProcessIterator::ProcessIterator(const ProcessFilter* filter)
+    : filter_(filter) {}
+
+ProcessIterator::~ProcessIterator() = default;
+
+bool ProcessIterator::CheckForNextProcess() {
+  team_info info;
+  while (get_next_team_info(&team_cookie_, &info) == B_OK) {
+    // The kernel team has no executable image; skip it like the Linux
+    // iterator skips kernel threads.
+    if (info.team == B_SYSTEM_TEAM) {
+      continue;
+    }
+
+    FilePath exe = GetProcessExecutablePath(info.team);
+    if (exe.empty()) {
+      continue;
+    }
+
+    entry_.pid_ = info.team;
+    entry_.ppid_ = GetParentProcessId(info.team);
+    pid_t pgid = getpgid(info.team);
+    entry_.gid_ = pgid < 0 ? 0 : pgid;
+    entry_.exe_file_ = exe.BaseName().value();
+
+    // team_info::args holds the space-separated command line, truncated to
+    // sizeof(args) bytes. That is the best the public API offers.
+    std::string args(info.args, strnlen(info.args, sizeof(info.args)));
+    entry_.cmd_line_args_ =
+        SplitString(args, " ", KEEP_WHITESPACE, SPLIT_WANT_NONEMPTY);
+    return true;
+  }
+  return false;
+}
+
+bool NamedProcessIterator::IncludeEntry() {
+  if (executable_name_ != entry().exe_file()) {
+    return false;
+  }
+  return ProcessIterator::IncludeEntry();
+}
+
+}  // namespace base
diff --git a/base/process/process_metrics_haiku.cc b/base/process/process_metrics_haiku.cc
new file mode 100644
index 0000000000..20f64647ef
--- /dev/null
+++ b/base/process/process_metrics_haiku.cc
@@ -0,0 +1,170 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_metrics.h"
+
+#include <OS.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <sys/resource.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <algorithm>
+
+#include "base/memory/ptr_util.h"
+#include "base/notimplemented.h"
+#include "base/process/process_handle.h"
+#include "base/values.h"
+
+namespace base {
+
+namespace {
+
+bool GetHaikuSystemInfo(system_info* info) {
+  return get_system_info(info) == B_OK;
+}
+
+}  // namespace
+
+ProcessMetrics::ProcessMetrics(ProcessHandle process) : process_(process) {}
+
+// static
+std::unique_ptr<ProcessMetrics> ProcessMetrics::CreateProcessMetrics(
+    ProcessHandle process) {
+  return WrapUnique(new ProcessMetrics(process));
+}
+
+base::expected<ProcessMemoryInfo, ProcessUsageError>
+ProcessMetrics::GetMemoryInfo() const {
+  team_info team;
+  if (get_team_info(process_, &team) != B_OK) {
+    return base::unexpected(ProcessUsageError::kProcessNotFound);
+  }
+
+  // Resident set = pages of the team's areas that are currently in RAM.
+  uint64_t resident = 0;
+  area_info area;
+  ssize_t cookie = 0;
+  while (get_next_area_info(process_, &cookie, &area) == B_OK) {
+    resident += area.ram_size;
+  }
+
+  ProcessMemoryInfo memory_info;
+  memory_info.resident_set_bytes = resident;
+  return memory_info;
+}
+
+base::expected<TimeDelta, ProcessCPUUsageError>
+ProcessMetrics::GetCumulativeCPUUsage() {
+  team_usage_info usage;
+  if (get_team_usage_info(process_, B_TEAM_USAGE_SELF, &usage) != B_OK) {
+    return base::unexpected(ProcessCPUUsageError::kProcessNotFound);
+  }
+  // bigtime_t is in microseconds.
+  return base::ok(Microseconds(usage.user_time + usage.kernel_time));
+}
+
+size_t GetSystemCommitCharge() {
+  system_info info;
+  if (!GetHaikuSystemInfo(&info)) {
+    return 0;
+  }
+  // In KiB, as documented in process_metrics.h.
+  return static_cast<size_t>(info.used_pages) * (B_PAGE_SIZE / 1024);
+}
+
+int64_t GetNumberOfThreads(ProcessHandle process) {
+  team_info team;
+  if (get_team_info(process, &team) != B_OK) {
+    return 0;
+  }
+  return team.thread_count;
+}
+
+bool GetSystemMemoryInfo(SystemMemoryInfo* meminfo) {
+  system_info info;
+  if (!GetHaikuSystemInfo(&info)) {
+    return false;
+  }
+  const uint64_t page = B_PAGE_SIZE;
+  const uint64_t total = static_cast<uint64_t>(info.max_pages) * page;
+  const uint64_t used = static_cast<uint64_t>(info.used_pages) * page;
+  const uint64_t cached =
+      (static_cast<uint64_t>(info.cached_pages) + info.block_cache_pages) *
+      page;
+  meminfo->total = ByteSize(total);
+  meminfo->free = ByteSize(total > used ? total - used : 0);
+  meminfo->available =
+      ByteSize(std::min<uint64_t>(total, (total > used ? total - used : 0) +
+                                             cached));
+  meminfo->cached = ByteSize(cached);
+  meminfo->swap_total =
+      ByteSize(static_cast<uint64_t>(info.max_swap_pages) * page);
+  meminfo->swap_free =
+      ByteSize(static_cast<uint64_t>(info.free_swap_pages) * page);
+  return true;
+}
+
+int ProcessMetrics::GetOpenFdCount() const {
+  // There is no public API to enumerate another team's descriptors.
+  if (process_ != GetCurrentProcessHandle()) {
+    return -1;
+  }
+  int count = 0;
+  const int max_fd = getdtablesize();
+  for (int fd = 0; fd < max_fd; ++fd) {
+    if (fcntl(fd, F_GETFD) != -1) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+int ProcessMetrics::GetOpenFdSoftLimit() const {
+  if (process_ != GetCurrentProcessHandle()) {
+    return -1;
+  }
+  struct rlimit limit;
+  if (getrlimit(RLIMIT_NOFILE, &limit) != 0) {
+    return -1;
+  }
+  return limit.rlim_cur == RLIM_INFINITY ? -1
+                                         : static_cast<int>(limit.rlim_cur);
+}
+
+int ProcessMetrics::GetIdleWakeupsPerSecond() {
+  NOTIMPLEMENTED();
+  return 0;
+}
+
+bool GetSystemDiskInfo(SystemDiskInfo* diskinfo) {
+  NOTIMPLEMENTED();
+  return false;
+}
+
+bool GetVmStatInfo(VmStatInfo* vmstat) {
+  NOTIMPLEMENTED();
+  return false;
+}
+
+SystemDiskInfo::SystemDiskInfo() {
+  reads = 0;
+  reads_merged = 0;
+  sectors_read = 0;
+  read_time = 0;
+  writes = 0;
+  writes_merged = 0;
+  sectors_written = 0;
+  write_time = 0;
+  io = 0;
+  io_time = 0;
+  weighted_io_time = 0;
+}
+
+SystemDiskInfo::SystemDiskInfo(const SystemDiskInfo& other) = default;
+
+SystemDiskInfo& SystemDiskInfo::operator=(const SystemDiskInfo&) = default;
+
+}  // namespace base
