index 0000000000..82065906f1
--- /dev/null
+++ b/base/system/sys_info_haiku.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/system/sys_info.h"
+
+#include <OS.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <string>
+
+#include "base/byte_size.h"
+#include "base/check.h"
+#include "base/cpu.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace base {
+
+namespace {
+
+bool GetSystemInfo(system_info* info) {
+  return get_system_info(info) == B_OK;
+}
+
+}  // namespace
+
+// static
+int SysInfo::NumberOfProcessors() {
+  system_info info;
+  if (!GetSystemInfo(&info) || info.cpu_count == 0) {
+    return 1;
+  }
+  return static_cast<int>(info.cpu_count);
+}
+
+// static
+ByteSize SysInfo::AmountOfTotalPhysicalMemoryImpl() {
+  system_info info;
+  if (!GetSystemInfo(&info)) {
+    return ByteSize(0);
+  }
+  return ByteSize(static_cast<uint64_t>(info.max_pages) * B_PAGE_SIZE);
+}
+
+// static
+ByteSize SysInfo::AmountOfAvailablePhysicalMemoryImpl() {
+  system_info info;
+  if (!GetSystemInfo(&info)) {
+    return ByteSize(0);
+  }
+  // Cached and block-cache pages are counted in used_pages but are reclaimed
+  // on demand, so treat them as available like Linux's MemAvailable does.
+  uint64_t free_pages = static_cast<uint64_t>(info.max_pages) - info.used_pages;
+  free_pages += info.cached_pages + info.block_cache_pages;
+  free_pages = std::min<uint64_t>(free_pages, info.max_pages);
+  return ByteSize(free_pages * B_PAGE_SIZE);
+}
+
+// static
+std::string SysInfo::CPUModelName() {
+#if defined(ARCH_CPU_X86_FAMILY)
+  return std::string(TrimWhitespaceASCII(CPU().cpu_brand(), TRIM_ALL));
+#else
+  return std::string();
+#endif
+}
+
+// static
+uint64_t SysInfo::MaxSharedMemorySize() {
+  // Haiku has no SysV shmmax-style limit for the areas backing shared memory;
+  // physical memory is the effective bound.
+  return AmountOfTotalPhysicalMemoryImpl().InBytes();
+}
+
+// static
+SysInfo::HardwareInfo SysInfo::GetHardwareInfoSync() {
+  HardwareInfo info;
+  info.manufacturer = "Haiku";
+  info.model = HardwareModelName();
+  DCHECK(IsStringUTF8(info.manufacturer));
+  DCHECK(IsStringUTF8(info.model));
+  return info;
+}
+
+}  // namespace base
