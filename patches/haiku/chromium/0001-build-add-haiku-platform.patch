--- a/base/allocator/partition_allocator/src/partition_alloc/build_config.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/build_config.h
@@ -18,7 +18,7 @@
 //
 // Operating system:
 //   IS_IOS / IS_AIX / IS_ASMJS / IS_FREEBSD / IS_FUCHSIA / IS_LINUX / IS_MAC /
-//   IS_NETBSD / IS_OPENBSD / IS_QNX / IS_SOLARIS / IS_WIN
+//   IS_HAIKU / IS_NETBSD / IS_OPENBSD / IS_QNX / IS_SOLARIS / IS_WIN
 //
 // Operating system family:
 //   IS_APPLE / IS_BSD / IS_POSIX
@@ -104,6 +104,8 @@
 #define PA_IS_AIX
 #elif defined(__asmjs__) || defined(__wasm__)
 #define PA_IS_ASMJS
+#elif defined(__HAIKU__)
+#define PA_IS_HAIKU
 #endif
 
 // NOTE: Adding a new port? Please follow
@@ -120,7 +122,7 @@
 #if defined(PA_IS_AIX) || defined(PA_IS_ASMJS) || defined(PA_IS_FREEBSD) ||  \
     defined(PA_IS_IOS) || defined(PA_IS_LINUX) || defined(PA_IS_CHROMEOS) || \
     defined(PA_IS_MAC) || defined(PA_IS_NETBSD) || defined(PA_IS_OPENBSD) || \
-    defined(PA_IS_QNX) || defined(PA_IS_SOLARIS) ||                          \
+    defined(PA_IS_QNX) || defined(PA_IS_SOLARIS) || defined(PA_IS_HAIKU) ||  \
     PA_BUILDFLAG(IS_ANDROID) || PA_BUILDFLAG(IS_CHROMEOS)
 #define PA_IS_POSIX
 #endif
@@ -426,6 +428,13 @@
 #endif
 #undef PA_IS_FUCHSIA
 
+#if defined(PA_IS_HAIKU)
+#define PA_BUILDFLAG_INTERNAL_IS_HAIKU() (1)
+#else
+#define PA_BUILDFLAG_INTERNAL_IS_HAIKU() (0)
+#endif
+#undef PA_IS_HAIKU
+
 #if defined(PA_IS_IOS)
